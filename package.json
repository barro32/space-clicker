{
  "name": "ai-game",
  "version": "1.0.0",
  "description": "Space Evolution - A space-themed idle game with rockets, orbital mechanics, contracts, and lunar exploration",
  "main": "electron-main.js",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "dev": "vite",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "vite build",
    "build:electron": "npm run build && electron-builder --win --publish never",
    "preview": "vite preview"
  },
  "keywords": [
    "idle-game",
    "react",
    "typescript",
    "space",
    "simulation",
    "incremental"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "tailwindcss": "^4.2.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.2",
    "jsdom": "^29.0.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "build": {
    "appId": "com.spaceevolution.game",
    "productName": "Space Evolution",
    "files": [
      "dist/**/*",
      "electron-main.js",
      "electron-preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Space Evolution"
    }
  }
}
